-- NO KNOCKBACK
-- ════════════════════════════════════════════════════════════════════════════

local NK = { enabled = false, charConn = nil }

local function nk_getRef()
    local Pkgs = ReplicatedStorage:FindFirstChild("Packages"); if not Pkgs then return nil end
    local Net  = Pkgs:FindFirstChild("Networking");           if not Net  then return nil end
    return Net:FindFirstChild("RE/RigSync/Refresh")
end

local function nk_patch()
    if type(getconnections) ~= "function" then return warn("[NK] getconnections missing") end
    local ref = nk_getRef(); if not ref then return warn("[NK] RE/RigSync/Refresh not found") end
    local conns = getconnections(ref); if not conns then return end
    local n = 0
    for _, c in next, conns do c:Disconnect(); n += 1 end
    print(("[NK] patched %d connection(s)"):format(n))
end

local function nk_enable()
    NK.enabled = true
    nk_patch()
    if NK.charConn then NK.charConn:Disconnect() end
    NK.charConn = LocalPlayer.CharacterAdded:Connect(function() task.defer(nk_patch) end)
    print("[NK] ON")
end

local function nk_disable()
    NK.enabled = false
    if NK.charConn then NK.charConn:Disconnect(); NK.charConn = nil end
    warn("[NK] OFF — connections restore on next respawn")
end

