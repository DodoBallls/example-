-- KILL AURA
-- Source: robscript.com/steal-an-egg-scripts/#l10scripts-kill-aura
-- fires RE/BatSwing/Trigger at closest player within KA.range studs every 0.1s
-- ════════════════════════════════════════════════════════════════════════════

local KA = {
    enabled = false,
    range   = 16.5,   -- default, slider adjusts this (1–1000)
    conn    = nil,
    last    = 0,
    -- module refs
    BatSwingRemote   = nil,
    ToolGameplayGuard = nil,
}

local function ka_init()
    -- bind RE/BatSwing/Trigger
    local Pkgs = ReplicatedStorage:FindFirstChild("Packages")
    local Net  = Pkgs and Pkgs:FindFirstChild("Networking")
    if Net then
        KA.BatSwingRemote = Net:FindFirstChild("RE/BatSwing/Trigger")
    end
    if not KA.BatSwingRemote then
        warn("[KA] RE/BatSwing/Trigger not found")
        return false
    end
    -- bind ToolGameplayGuard
    local Client = ReplicatedStorage:FindFirstChild("Client")
    if Client then
        local tgg = Client:FindFirstChild("ToolGameplayGuard")
        if tgg then
            local ok, mod = pcall(require, tgg)
            if ok then KA.ToolGameplayGuard = mod end
        end
    end
    return true
end

local function ka_createSeed()
    local s, r = pcall(function()
        return ("%*:%*:%*"):format(
            LocalPlayer.UserId,
            100,
            math.floor(Workspace:GetServerTimeNow() * 1000)
        )
    end)
    return s and r or nil
end

local function ka_canUseTool()
    local s, r = pcall(function()
        local c = LocalPlayer.Character; if not c then return false end
        local t = c:FindFirstChildOfClass("Tool")
        if not t or t:GetAttribute("ItemType") ~= "Gear" then return false end
        local h = c:FindFirstChild("HumanoidRootPart"); if not h then return false end
        if KA.ToolGameplayGuard and not KA.ToolGameplayGuard.IsLocalInsideArena() then return false end
        if Workspace:GetAttribute("Event_MonsterEvent") then
            return h.Position.Z > -268
        end
        return true
    end)
    return s and r or false
end

local function ka_getClosest()
    local best, bestDist = nil, math.huge
    for _, p in next, Players:GetPlayers() do
        if p == LocalPlayer then continue end
        local char = p.Character; if not char then continue end
        local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then continue end
        local dist = LocalPlayer:DistanceFromCharacter(hrp.Position)
        if dist < bestDist and dist <= KA.range then
            bestDist = dist; best = p
        end
    end
    return best
end

local function ka_attack(target)
    if not KA.BatSwingRemote then return end
    pcall(function()
        KA.BatSwingRemote:FireServer(target, ka_createSeed())
    end)
end

local function ka_enable()
    if not ka_init() then
        warn("[KA] init failed — toggle off")
        KA.enabled = false
        return
    end
    KA.enabled = true
    KA.last    = tick()
    if KA.conn then KA.conn:Disconnect() end
    KA.conn = RunService.Heartbeat:Connect(function()
        if not KA.enabled then return end
        local target = ka_getClosest()
        if target and tick() - KA.last >= 0.1 and ka_canUseTool() then
            ka_attack(target)
            KA.last = tick()
        end
    end)
    print(("[KA] ON — range: %d studs"):format(KA.range))
end

local function ka_disable()
    KA.enabled = false
    if KA.conn then KA.conn:Disconnect(); KA.conn = nil end
    print("[KA] OFF")
end

