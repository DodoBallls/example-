task.spawn(function()
    while running do
        task.wait(0.1)
        local root = getRoot(); local hum = getHumanoid()
        if root and hum and hum:GetAttribute("BobloStealHum") == true then
            local lY = getLaneY(); local vel = root.AssemblyLinearVelocity
            if root.Position.Y > lY + 12 then
                local gy = groundedY(root.Position.X, root.Position.Z, lY)
                root.CFrame = CFrame.new(root.Position.X, gy, root.Position.Z)
