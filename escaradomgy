-- SPEED HACK
-- ════════════════════════════════════════════════════════════════════════════

local SP = { enabled = false, speed = 500, lock = nil, hbConn = nil, hooksReady = false, oldNewindex = nil }

local function sp_checkExecutor()
    local miss = {}
    if type(hookmetamethod)    ~= "function" then table.insert(miss, "hookmetamethod")    end
    if type(hookfunction)      ~= "function" then table.insert(miss, "hookfunction")      end
    if type(getgc)             ~= "function" then table.insert(miss, "getgc")             end
    if type(islclosure)        ~= "function" then table.insert(miss, "islclosure")        end
    if type(debug) ~= "table" or type(debug.info) ~= "function" or type(debug.getupvalues) ~= "function" then
        table.insert(miss, "debug.info/getupvalues")
    end
    return #miss == 0, miss
end

local function sp_installHooks()
    if SP.hooksReady then return end
    local guard = function(self, key, value)
        if SP.lock and key == "WalkSpeed" and value ~= SP.lock then
            local char = LocalPlayer.Character
            if char and self == char:FindFirstChildOfClass("Humanoid") then return end
        end
        return SP.oldNewindex(self, key, value)
    end
    if type(newcclosure) == "function" then guard = newcclosure(guard) end
    SP.oldNewindex = hookmetamethod(game, "__newindex", guard)
    local blinded = 0
    for _, fn in next, getgc() do
        if typeof(fn) == "function" and islclosure(fn) then
            local okS, src = pcall(debug.info, fn, "s")
            if okS and type(src) == "string" and src:find("ContentCatalog%.Runtime") then
                local okA, params = pcall(debug.info, fn, "a")
                local okU, ups    = pcall(debug.getupvalues, fn)
                if okA and params == 3 and okU and type(ups) == "table" and #ups == 5 then
                    local orig
                    local wrap = function(a, b, c)
                        local s = orig(a, b, c)
                        if type(s) == "table" and s.WalkSpeed and s.Position and s.Timestamp then
                            s.WalkSpeed = 100000
                        end
                        return s
                    end
                    if type(newlclosure) == "function" then wrap = newlclosure(wrap) end
                    local ok = pcall(function() orig = hookfunction(fn, wrap) end)
                    if ok and type(orig) == "function" then blinded += 1 end
                end
            end
        end
    end
    SP.hooksReady = true
    if blinded > 0 then print(("[Speed] AC sampler blinded (%d fn)"):format(blinded))
    else warn("[Speed] AC sampler not found — rubber-band possible") end
end

local function sp_enable()
    local ok, miss = sp_checkExecutor()
    if not ok then warn("[Speed] missing: " .. table.concat(miss, ", ") .. " — basic mode only")
    else sp_installHooks() end
    SP.lock = SP.speed; SP.enabled = true
    if SP.hbConn then SP.hbConn:Disconnect() end
    SP.hbConn = RunService.Heartbeat:Connect(function()
        if not SP.enabled then return end
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.WalkSpeed ~= SP.speed then hum.WalkSpeed = SP.speed end
    end)
    print(("[Speed] ON — WalkSpeed %d"):format(SP.speed))
end

local function sp_disable()
    SP.enabled = false; SP.lock = nil
    if SP.hbConn then SP.hbConn:Disconnect(); SP.hbConn = nil end
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = 16 end
    print("[Speed] OFF — WalkSpeed → 16")
end

