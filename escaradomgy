local function findModule(name)
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("ModuleScript") and d.Name == name then
            local ok, mod = pcall(require, d)
            if ok then return mod end
        end
    end
end

local function requirePath(timeout, ...)
    local cur = ReplicatedStorage
    for _, name in ipairs({...}) do
        if not cur then return nil end
        cur = cur:FindFirstChild(name) or cur:WaitForChild(name, timeout or 4)
    end
    if not cur then return nil end
    local ok, mod = pcall(require, cur)
    return ok and mod or nil
end

local function pickFn(mod, ...)
    if type(mod) ~= "table" then return nil end
    for i = 1, select("#", ...) do
        local fn = mod[select(i, ...)]
        if type(fn) == "function" then return fn end
    end
end

local function findRemoteContains(...)
    local parts = {...}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local ok = true
            for _, p in ipairs(parts) do
                if not d.Name:find(p, 1, true) then ok = false; break end
            end
            if ok then return d end
        end
    end
end

